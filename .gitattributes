# Force LF line endings for source code
*.py    text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.jar binary
*.apk binary
*.aab binary

# Don't normalize these
*.keystore binary
*.db binary
*.sqlite binary
*.db-journal binary
